# ---------------------------------------------------------------------------
# Cinemateca Sensorial — variables de entorno
# ---------------------------------------------------------------------------
# TODAS las variables con prefijo VITE_ se inyectan en el bundle del cliente.
# Por diseño, NINGUNA de ellas debe contener un secreto de producción: en el
# pipeline CI/CD se usan exclusivamente durante la compilación para generar
# datos semilla estáticos (scripts/generate-seeds.mjs) y jamás se publican en
# el artefacto desplegado si el build se hace con `--mode production` sin
# exponerlas (ver .github/workflows/deploy.yml).
#
# Copia este archivo como `.env.local` para desarrollo. Nunca lo commitees.
# ---------------------------------------------------------------------------

# Ruta base del despliegue. GitHub Pages: "/<nombre-del-repositorio>/"
VITE_BASE_PATH=/

# En el build, estas dos variables se incrustan ADEMÁS como «acceso
# comunitario» ofuscado (XOR + base64) para que CUALQUIER visitante explore el
# catálogo mundial completo sin introducir claves (src/lib/env.ts). Ni el
# repositorio ni el bundle contienen el valor en claro; audit-secrets.mjs lo
# verifica en dist/ antes de desplegar.
# Clave TMDB v3 (api_key) o token v4 (Bearer). Solo para DESARROLLO o para
# generar las semillas estáticas en CI. En producción el usuario introduce la
# suya en el panel de Configuración (localStorage, nunca en el bundle).
VITE_TMDB_API_KEY=
VITE_TMDB_READ_TOKEN=

# Base alternativa del CDN de imágenes de TMDB (proxy propio, caché, pruebas).
VITE_TMDB_IMAGE_BASE=

# Proxy CORS opcional usado para resolver el ID exacto de FilmAffinity en el
# navegador. Debe anteponer la URL destino. Vacío = enlace de búsqueda.
VITE_CORS_PROXY_URL=

# Proveedor LLM compatible con OpenAI (ensayos de "alma gemela").
# Endpoint por defecto: https://api.openai.com/v1/chat/completions
VITE_LLM_PROVIDER=
VITE_LLM_API_KEY=
VITE_LLM_MODEL=
VITE_LLM_BASE_URL=

# Versión visible en el pie de la aplicación.
VITE_APP_VERSION=1.0.0
